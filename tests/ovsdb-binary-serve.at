AT_SETUP([binary serve - concurrent queries on large binary DB])
AT_KEYWORDS([ovsdb binary-serve concurrent])
AT_SKIP_IF([test "$IS_WIN32" = "yes"])
ordinal_schema > schema
AT_CHECK([ovsdb-tool create db schema], [0], [ignore])
dnl Insert many rows to exercise the lazy-load path.
for i in $(seq 1 50); do
    AT_CHECK([ovsdb-tool transact db \
      '["ordinals",
        {"op": "insert",
         "table": "ordinals",
         "row": {"number": '$i', "name": "row'$i'"}}]'],
      [0], [ignore])
done
AT_CHECK([ovsdb-tool convert-format db binary], [0])
AT_CHECK([ovsdb-server --disk-store --detach --no-chdir \
          --pidfile --remote=punix:db.sock \
          --unixctl="`pwd`"/unixctl db], [0])
dnl Send multiple queries concurrently.
for i in 1 2 3 4 5; do
    ovsdb-client transact unix:db.sock \
      '["ordinals",
        {"op": "select",
         "table": "ordinals",
         "where": []}]' > result$i.json 2>/dev/null &
done
wait
dnl All should succeed and contain data.
for i in 1 2 3 4 5; do
    AT_CHECK([test -s result$i.json])
    AT_CHECK([grep -c '"row1"' result$i.json], [0], [ignore])
done
OVS_APP_EXIT_AND_WAIT([ovsdb-server])
AT_CLEANUP

AT_SETUP([binary serve - real error not parked indefinitely])
AT_KEYWORDS([ovsdb binary-serve error])
AT_SKIP_IF([test "$IS_WIN32" = "yes"])
ordinal_schema > schema
AT_CHECK([ovsdb-tool create db schema], [0], [ignore])
AT_CHECK([ovsdb-tool convert-format db binary], [0])
AT_CHECK([ovsdb-server --disk-store --detach --no-chdir \
          --pidfile --remote=punix:db.sock \
          --unixctl="`pwd`"/unixctl db], [0])
dnl Send a malformed transaction — this should return an error
dnl immediately, not park forever.
AT_CHECK([ovsdb-client transact unix:db.sock \
  '["ordinals",
    {"op": "mutate",
     "table": "ordinals",
     "where": [["name", "==", "nonexistent"]],
     "mutations": [["number", "+=", 1]]}]'], [0], [stdout])
dnl Should complete quickly (not hang) and contain a result.
AT_CHECK([test -s stdout])
OVS_APP_EXIT_AND_WAIT([ovsdb-server])
AT_CLEANUP

AT_SETUP([binary serve - lazy-load C unit tests])
AT_KEYWORDS([ovsdb binary-serve lazy-load])
AT_CHECK([ovstest test-lazy-load], [0], [test-lazy-load: ok
])
AT_CLEANUP

dnl Regression test: monitor initial snapshot must include rows
dnl for a freshly-converted binary database.  Before the deferred
dnl monitor fix, table->rows was empty in disk-store mode and the
dnl monitor returned an empty initial snapshot, which broke
dnl ovn-nbctl show and similar tools.
AT_SETUP([binary serve - monitor returns initial rows from binary DB])
AT_KEYWORDS([ovsdb binary-serve monitor regression])
AT_SKIP_IF([test "$IS_WIN32" = "yes"])
ordinal_schema > schema
AT_CHECK([ovsdb-tool create db schema], [0], [ignore])
dnl Insert several rows BEFORE conversion so they live only on disk
dnl when the server starts (not yet loaded into memory).
AT_CHECK([ovsdb-tool transact db \
  '["ordinals",
    {"op": "insert",
     "table": "ordinals",
     "row": {"number": 1, "name": "one"}},
    {"op": "insert",
     "table": "ordinals",
     "row": {"number": 2, "name": "two"}},
    {"op": "insert",
     "table": "ordinals",
     "row": {"number": 3, "name": "three"}}]'], [0], [ignore])
AT_CHECK([ovsdb-tool convert-format db binary], [0])
AT_CHECK([ovsdb-server --disk-store --detach --no-chdir \
          --pidfile --remote=punix:db.sock \
          --unixctl="`pwd`"/unixctl db], [0])
dnl Issue a monitor request via ovsdb-client.  Block in the
dnl background and capture the first <table-updates> message
dnl which carries the initial snapshot.
ovsdb-client --timeout=10 monitor unix:db.sock ordinals ordinals \
    > monitor.out 2>monitor.err &
mon_pid=$!
dnl Wait briefly for the initial snapshot to arrive.
OVS_WAIT_UNTIL([test -s monitor.out])
kill "$mon_pid" 2>/dev/null
wait "$mon_pid" 2>/dev/null
dnl The snapshot must include all three rows.
AT_CHECK([grep -c '"one"' monitor.out], [0], [1
])
AT_CHECK([grep -c '"two"' monitor.out], [0], [1
])
AT_CHECK([grep -c '"three"' monitor.out], [0], [1
])
OVS_APP_EXIT_AND_WAIT([ovsdb-server])
AT_CLEANUP

dnl ---------------------------------------------------------------
dnl T1: Restart correctness — UUID lookup finds pre-existing row
dnl ---------------------------------------------------------------
AT_SETUP([binary serve - UUID lookup after restart])
AT_KEYWORDS([ovsdb binary-serve restart uuid])
AT_SKIP_IF([test "$IS_WIN32" = "yes"])
ordinal_schema > schema
AT_CHECK([ovsdb-tool create db schema], [0], [ignore])
dnl Insert row and capture its UUID.
AT_CHECK([ovsdb-tool transact db \
  '["ordinals",
    {"op": "insert",
     "table": "ordinals",
     "row": {"number": 10, "name": "ten"}}]'], [0], [stdout])
AT_CHECK([sed 's/.*"uuid":\[.*"\(.*\)"\].*/\1/' stdout > uuid.txt])
AT_CHECK([ovsdb-tool convert-format db binary], [0])
dnl First run — start and stop.
AT_CHECK([ovsdb-server --disk-store --detach --no-chdir \
          --pidfile --remote=punix:db.sock \
          --unixctl="`pwd`"/unixctl db], [0])
OVS_APP_EXIT_AND_WAIT([ovsdb-server])
dnl Second run — restart and query by UUID.
AT_CHECK([ovsdb-server --disk-store --detach --no-chdir \
          --pidfile --remote=punix:db.sock \
          --unixctl="`pwd`"/unixctl db], [0])
uuid=$(cat uuid.txt)
AT_CHECK([ovsdb-client transact unix:db.sock \
  '["ordinals",
    {"op": "select",
     "table": "ordinals",
     "where": [["_uuid", "==", ["uuid", "'$uuid'"]]]}]'], [0], [stdout])
AT_CHECK([grep -c '"ten"' stdout], [0], [1
])
OVS_APP_EXIT_AND_WAIT([ovsdb-server])
AT_CLEANUP

